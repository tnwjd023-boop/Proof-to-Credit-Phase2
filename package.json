{
  "name": "proof-to-credit",
  "version": "0.1.0",
  "private": true,
  "description": "Loan-scoped proof-derived principal for a separate credit-allocation policy",
  "type": "commonjs",
  "scripts": {
    "build:pages": "node scripts/build-pages.js",
    "check-env": "node scripts/check-env.js",
    "cc3:deploy": "node scripts/deploy-cc3.js",
    "cc3:submit": "node scripts/submit-proof.js",
    "demo": "node scripts/demo.js",
    "compile": "node scripts/compile.js",
    "proof:fetch": "node scripts/fetch-proof.js",
    "probe": "node scripts/probe-proof.js",
    "resume": "node scripts/resume.js",
    "source:deploy": "node scripts/deploy-source.js",
    "source:open": "node scripts/source-actions.js open --amount 50",
    "source:repay": "node scripts/source-actions.js repay --amount 20",
    "test": "node --test",
    "ui": "node scripts/serve-ui.js",
    "wallet:create": "node scripts/create-testnet-wallet.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ethereumjs/common": "4.4.0",
    "@ethereumjs/tx": "5.4.0",
    "@ethereumjs/util": "9.1.0",
    "@ethereumjs/vm": "8.1.1",
    "@gluwa/usc-contracts": "0.1.2",
    "@gluwa/usc-sdk": "0.18.0",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "solc": "0.8.36"
  }
}
